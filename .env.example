# ---------------------------------------------------------------
# Food Delivery E2E Test Environment Variables
# Copy this file to .env and fill in real values before running.
# ---------------------------------------------------------------

# Frontend base URL (Vite dev server)
FRONTEND_BASE_URL=http://localhost:5173

# Backend base URL (Express server — port 4000 by default)
BACKEND_BASE_URL=http://localhost:4000

# Credentials for an existing test account (must be pre-seeded in the DB)
E2E_USER_EMAIL=testuser@example.com
E2E_USER_PASSWORD=TestPassword123

# Credentials for a brand-new account (registration tests only)
# IMPORTANT: delete this user from the DB between runs so registration is idempotent
E2E_NEW_USER_EMAIL=newuser_e2e@example.com
E2E_NEW_USER_PASSWORD=NewPassword123!

# Set to "false" to run tests in a headed (visible) browser window
HEADLESS=true
